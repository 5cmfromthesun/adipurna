<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - ADIPURNA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .thumb-img {
            width: 60px;
            height: 60px;
            object-fit: contain;
            background-color: #f8f9fa;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/admin">ADIPURNA Admin Panel</a>
            <a href="/" class="btn btn-outline-light btn-sm">Go to Store</a>
        </div>
    </nav>

    <div class="container">
        <!-- CREATE FORM -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">Add New Product</div>
            <div class="card-body">
                <form action="/admin/products" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Product Name</label>
                            <input type="text" class="form-control" name="nama_produk" required>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Price (Rp)</label>
                            <input type="number" class="form-control" name="harga" required>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Stock</label>
                            <input type="number" class="form-control" name="stok" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Product Photo (S3)</label>
                            <input type="file" class="form-control" name="foto" accept="image/*" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">Save Product</button>
                </form>
            </div>
        </div>

        <!-- READ, UPDATE, DELETE -->
        <h5 class="mb-3">Product List</h5>
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Photo</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products.length > 0) { %>
                        <% products.forEach(function(product) { %>
                            <tr>
                                <td>
                                    <img src="<%= product.foto_url || 'https://via.placeholder.com/60' %>" class="thumb-img border">
                                </td>
                                <td class="fw-bold"><%= product.nama_produk %></td>
                                <td>Rp <%= Number(product.harga).toLocaleString('en-US') %></td>
                                <td><%= product.stok %></td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1" data-bs-toggle="modal" data-bs-target="#editModal<%= product.id %>">Edit</button>
                                    
                                    <form action="/admin/products/delete/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>

                            <!-- MODAL UPDATE -->
                            <div class="modal fade" id="editModal<%= product.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/admin/products/update/<%= product.id %>" method="POST" enctype="multipart/form-data">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Edit Product</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Product Name</label>
                                                    <input type="text" class="form-control" name="nama_produk" value="<%= product.nama_produk %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Price (Rp)</label>
                                                    <input type="number" class="form-control" name="harga" value="<%= product.harga %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Stock</label>
                                                    <input type="number" class="form-control" name="stok" value="<%= product.stok %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Change Photo (Optional)</label>
                                                    <input type="file" class="form-control" name="foto" accept="image/*">
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted">No products yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>