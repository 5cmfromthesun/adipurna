<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - ADIPURNA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">ADIPURNA Wholesale Store</a>
        </div>
    </nav>
    <div class="container">
        <h4 class="mb-4">Checkout</h4>
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">Customer Information</div>
                    <div class="card-body">
                        <form action="/checkout" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" name="customer_name" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" name="customer_email" required>
                            </div>
                            <button type="submit" class="btn btn-success">Place Order</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Order Summary</div>
                    <div class="card-body">
                        <% cart.forEach(item => { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span><%= item.nama_produk %> x <%= item.quantity %></span>
                                <span>Rp <%= Number(item.harga * item.quantity).toLocaleString('en-US') %></span>
                            </div>
                        <% }); %>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <strong>Total</strong>
                            <strong>Rp <%= Number(total).toLocaleString('en-US') %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
