<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADIPURNA Wholesale Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .product-img {
            height: 200px;
            width: 100%;
            object-fit: contain;
            background-color: #f8f9fa;
            padding: 10px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">ADIPURNA Wholesale Store</a>
            <div>
                <a href="/cart" class="btn btn-light btn-sm me-2">Cart</a>
                <a href="/admin" class="btn btn-outline-light btn-sm">Admin Panel</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <% if (msg) { %>
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <h4 class="mb-4">Wholesale Product Catalog</h4>
        <div class="row">
            <% if (products.length > 0) { %>
                <% products.forEach(function(product) { %>
                    <div class="col-md-3 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <img src="<%= product.foto_url || 'https://via.placeholder.com/200?text=No+Image' %>" class="card-img-top product-img rounded-top" alt="<%= product.nama_produk %>">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-truncate"><%= product.nama_produk %></h5>
                                <p class="card-text mb-1 text-primary fw-bold">Rp <%= Number(product.harga).toLocaleString('en-US') %></p>
                                <p class="card-text text-muted mb-3"><small>Stock: <%= product.stok %></small></p>
                                
                                <div class="mt-auto">
                                    <% if (product.stok > 0) { %>
                                        <form action="/cart/add/<%= product.id %>" method="POST" class="mb-2">
                                            <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                                        </form>
                                        <form action="/order/<%= product.id %>" method="POST">
                                            <button type="submit" class="btn btn-success w-100">Buy Now</button>
                                        </form>
                                    <% } else { %>
                                        <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12"><p class="text-muted">No products available yet.</p></div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
