<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - ADIPURNA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">ADIPURNA Wholesale Store</a>
            <div>
                <a href="/cart" class="btn btn-light btn-sm me-2">Cart</a>
                <a href="/admin" class="btn btn-outline-light btn-sm">Admin Panel</a>
            </div>
        </div>
    </nav>
    <div class="container">
        <h4 class="mb-4">Shopping Cart</h4>
        <% if (cart && cart.length > 0) { %>
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% let total = 0; cart.forEach(item => { total += item.harga * item.quantity; %>
                    <tr>
                        <td><%= item.nama_produk %></td>
                        <td>Rp <%= Number(item.harga).toLocaleString('en-US') %></td>
                        <td><%= item.quantity %></td>
                        <td>Rp <%= Number(item.harga * item.quantity).toLocaleString('en-US') %></td>
                        <td>
                            <form action="/cart/remove/<%= item.id %>" method="POST">
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"><strong>Total</strong></td>
                        <td><strong>Rp <%= Number(total).toLocaleString('en-US') %></strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            <a href="/checkout" class="btn btn-success">Proceed to Checkout</a>
            <a href="/" class="btn btn-secondary">Continue Shopping</a>
        <% } else { %>
            <p class="text-muted">Your cart is empty.</p>
            <a href="/" class="btn btn-primary">Shop Now</a>
        <% } %>
    </div>
</body>
</html>
